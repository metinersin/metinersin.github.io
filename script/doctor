#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
quarto_bin="${QUARTO_BIN:-quarto}"

if ! command -v "$quarto_bin" >/dev/null 2>&1; then
    echo "Quarto is required. Install it from https://quarto.org/docs/get-started/" >&2
    exit 127
fi

"$quarto_bin" --version
"$quarto_bin" check
QUARTO_BIN="$quarto_bin" "$repo_root/script/build" "$@"
