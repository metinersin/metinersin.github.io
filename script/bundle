#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
homebrew_ruby="/opt/homebrew/opt/ruby/bin/ruby"
lockfile="$repo_root/Gemfile.lock"
ruby_version_file="$repo_root/.ruby-version"
bundle_slug="$(basename "$repo_root" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')"
bundle_slug="${bundle_slug#-}"
bundle_slug="${bundle_slug%-}"

if [[ -z "$bundle_slug" ]]; then
  bundle_slug="jekyll-site"
fi

bundler_version="$(
  awk '
    $0 == "BUNDLED WITH" {
      getline
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
      print
      exit
    }
  ' "$lockfile"
)"

if [[ -z "$bundler_version" ]]; then
  echo "Could not determine the Bundler version from $lockfile" >&2
  exit 1
fi

required_ruby_version=""
required_ruby_series=""

if [[ -f "$ruby_version_file" ]]; then
  required_ruby_version="$(tr -d '[:space:]' < "$ruby_version_file")"
  required_ruby_series="${required_ruby_version%.*}"
fi

matches_required_ruby() {
  local candidate_version="$1"

  if [[ -z "$required_ruby_version" ]]; then
    return 0
  fi

  [[ "$candidate_version" == "$required_ruby_version" || "$candidate_version" == "${required_ruby_series}".* ]]
}

select_ruby() {
  local candidate="$1"
  local candidate_version

  [[ -n "$candidate" && -x "$candidate" ]] || return 1

  candidate_version="$("$candidate" -e 'print RUBY_VERSION' 2>/dev/null)" || return 1

  if matches_required_ruby "$candidate_version"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

current_ruby="$(command -v ruby || true)"
ruby_bin=""

if ruby_bin="$(select_ruby "$current_ruby")"; then
  :
elif ruby_bin="$(select_ruby "$homebrew_ruby")"; then
  :
else
  echo "Could not find a Ruby compatible with $ruby_version_file" >&2

  if [[ -n "$required_ruby_version" ]]; then
    echo "Expected Ruby $required_ruby_version or another ${required_ruby_series}.x release." >&2
  fi

  if [[ -n "$current_ruby" ]]; then
    current_ruby_version="$("$current_ruby" -e 'print RUBY_VERSION' 2>/dev/null || echo unknown)"
    echo "ruby on PATH: $current_ruby ($current_ruby_version)" >&2
  else
    echo "ruby on PATH: not found" >&2
  fi

  if [[ -x "$homebrew_ruby" ]]; then
    homebrew_ruby_version="$("$homebrew_ruby" -e 'print RUBY_VERSION')"
    echo "Homebrew ruby: $homebrew_ruby ($homebrew_ruby_version)" >&2
  else
    echo "Homebrew ruby: not found at $homebrew_ruby" >&2
  fi

  echo "Install the version from $ruby_version_file or make it available on PATH." >&2
  exit 1
fi

gem_user_dir="$("$ruby_bin" -e 'require "rubygems"; print Gem.user_dir')"
ruby_bin_dir="$(dirname "$ruby_bin")"

export PATH="$gem_user_dir/bin:$ruby_bin_dir:$PATH"
export BUNDLE_GEMFILE="$repo_root/Gemfile"
export BUNDLE_PATH="${BUNDLE_PATH:-$HOME/.bundle/$bundle_slug}"

cd "$repo_root"

if ! bundle "_${bundler_version}_" -v >/dev/null 2>&1; then
  echo "Installing Bundler ${bundler_version} into ${gem_user_dir}" >&2
  gem install --user-install "bundler:${bundler_version}"
fi

if ! bundle "_${bundler_version}_" check >/dev/null 2>&1; then
  bundle "_${bundler_version}_" install
fi

exec bundle "_${bundler_version}_" "$@"
